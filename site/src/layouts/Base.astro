---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { congTy } from '../lib/data.js';
interface Props { title: string; description: string; noindex?: boolean; font?: string; jsonld?: object | object[]; current?: string; bare?: boolean }
const { title, description, noindex = false, font, jsonld, current = '', bare = false } = Astro.props;
const fullTitle = title.includes('Gió Nồm') ? title : `${title} | Gió Nồm Travel`;
const org = {
  '@context': 'https://schema.org', '@type': 'TravelAgency', name: congTy.ten,
  address: { '@type': 'PostalAddress', streetAddress: '68 Bạch Đằng', addressLocality: 'Đà Nẵng', addressCountry: 'VN' },
  telephone: congTy.dien_thoai_tel, email: congTy.email, openingHours: 'Mo-Su 07:00-21:00',
};
const ld = [org, ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : [])];
---
<!doctype html>
<html lang="vi" data-font={font}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1446a0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="vi_VN" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#noi-dung">Bỏ qua menu</a>
    {!bare && <Header current={current} />}
    <main id="noi-dung"><slot /></main>
    {!bare && <Footer />}
    <div class="toast" role="status" aria-live="polite" hidden></div>
    <script>
      import '../scripts/motion.js';
      import '../scripts/zalo.js';
    </script>
  </body>
</html>
<style is:global>
  .toast { position: fixed; left: 50%; bottom: calc(88px + env(safe-area-inset-bottom)); z-index: 90; transform: translateX(-50%);
    background: var(--c-asphalt); color: #fff; padding: 0.8rem 1.1rem; border-radius: var(--r-small); font-size: var(--fs-small);
    width: max-content; max-width: calc(100vw - 2rem); box-shadow: 0 10px 30px -10px rgba(0,0,0,.5); }
  .toast[data-show] { animation: toast-in 260ms var(--ease-out) both; }
  @keyframes toast-in { from { opacity: 0; transform: translate(-50%, 8px); } }
</style>
