---
// Trang dựng ảnh chia sẻ 1200×630 (chụp bằng Playwright ra public/og.png). noindex.
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '../styles/global.css';
import { tuyen } from '../lib/data.js';
import Icon from '../components/Icon.astro';
---
<html lang="vi"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title></head>
<body style="margin:0;width:1200px;height:630px;background:var(--c-asphalt)">
  <div class="sign" style="position:absolute;inset:36px 36px 90px;padding:44px 52px;display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center">
    <div>
      <p style="font-family:var(--f-display);font-weight:700;font-size:30px;color:var(--c-line);letter-spacing:.04em">GIÓ NỒM TRAVEL</p>
      <h1 style="font-size:104px;line-height:.92;margin-top:16px">Đà Nẵng lúc còn vắng</h1>
      <p style="margin-top:22px;font-size:26px;color:var(--c-on-sign-2)">Tour ghép tối đa 12 khách · giá đã gồm vé</p>
    </div>
    <ol style="list-style:none;margin:0;padding:0">
      {tuyen.map((r) => (
        <li style="display:flex;align-items:center;gap:16px;padding:10px 0;border-top:2px solid rgba(255,255,255,.22);color:#fff">
          <span style="width:40px;height:40px;border-radius:6px;background:#fff;color:var(--c-sign);display:grid;place-items:center"><Icon name={r.picto} size={26} /></span>
          <span style="flex:1;font-family:var(--f-display);font-weight:700;font-size:30px;text-transform:uppercase">{r.diem}</span>
          <span style="background:#fff;color:var(--c-time);border-radius:4px;padding:4px 8px 0;box-shadow:inset 0 4px 0 var(--c-cap);font-family:var(--f-display);font-weight:700;font-size:30px">{r.gio}</span>
        </li>
      ))}
    </ol>
  </div>
  <div class="road-line" style="position:absolute;left:0;right:0;bottom:40px"></div>
</body></html>
