---
import Base from '../../layouts/Base.astro';
import TourList from '../../components/TourList.astro';
import FilterChips from '../../components/FilterChips.astro';
import CtaBand from '../../components/CtaBand.astro';
import ActionBar from '../../components/ActionBar.astro';
import Icon from '../../components/Icon.astro';
import { tours, LOAI } from '../../lib/data.js';
const count = (k) => tours.filter((t) => LOAI(t) === k).length;
const chips = [
  { key: 'all', label: 'Tất cả', count: tours.length },
  { key: 'trong-ngay', label: 'Trong ngày', count: count('trong-ngay') },
  { key: 'nua-ngay', label: 'Nửa ngày', count: count('nua-ngay') },
  { key: 'qua-dem', label: 'Qua đêm', count: count('qua-dem') },
];
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: tours.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.ten, url: `/tour/${t.slug}/` })) };
---
<Base title="Tour Đà Nẵng, Hội An, Huế" description="Năm tour ghép nhóm nhỏ quanh Đà Nẵng: Bà Nà – Cầu Vàng, Hội An chiều tối, Cù Lao Chàm, Mỹ Sơn sáng sớm, Hải Vân – Huế 2N1Đ. Giá đã gồm vé, tối đa 12 khách." current="tour" jsonld={ld}>
  <header class="ch">
    <div class="wrap">
      <nav class="ch__crumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Tour</span></nav>
      <div class="sign ch__sign">
        <div>
          <h1>Tour Đà Nẵng, Hội An, Huế</h1>
          <p>Năm tour ghép, mỗi xe tối đa 12 khách. Giá cho một người lớn, đã gồm xe đón, vé tham quan và bữa ăn trong lịch trình.</p>
        </div>
        <ul class="ch__facts">
          <li><span class="ch__ic num">12</span>Tối đa 12 khách mỗi xe</li>
          <li><span class="ch__ic"><Icon name="hotel" size={22} /></span>Đón tận khách sạn nội thành</li>
          <li><span class="ch__ic"><Icon name="clock" size={22} /></span>Đi lệch giờ xe đoàn lớn</li>
          <li><span class="ch__ic num">24h</span>Huỷ miễn phí trước 24 giờ</li>
        </ul>
      </div>
    </div>
  </header>
  <section class="section ch__list" aria-label="Danh sách tour">
    <div class="wrap">
      <FilterChips group="loai" label="Lọc theo thời lượng" items={chips} />
      <p class="ch__count" aria-live="polite"><span data-count>{tours.length}</span> tour</p>
      <TourList list={tours} full level="h2" />
      <div class="ch__empty" data-empty hidden>
        <p>Chưa có tour nào khớp bộ lọc này.</p>
        <button type="button" class="link-arrow" data-reset>Xem tất cả 5 tour <Icon name="arrow-right" /></button>
      </div>
    </div>
  </section>
  <CtaBand title="Chưa chọn được?" body="Nhắn Gió Nồm ngày bạn rảnh và bạn đi cùng ai, Gió Nồm gợi ý tour hợp lịch." msg="Chào Gió Nồm, mình rảnh ngày …, đi cùng … Nên đi tour nào?" />
  <ActionBar always />
</Base>
<script>
  import { wireFilter } from '../../scripts/filter.js';
  const cnt = document.querySelector('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  wireFilter('loai', '.tl__row', 'loai', (n) => { if (cnt) cnt.textContent = String(n); if (empty) empty.hidden = n > 0; });
  document.querySelector('[data-reset]')?.addEventListener('click', () => (document.querySelector('[data-filter-group="loai"] [data-key="all"]') as HTMLButtonElement)?.click());
</script>
<style>
  .ch { padding-top: var(--sp-4); }
  .ch__crumbs { display: flex; gap: 0.4rem; font-size: var(--fs-small); color: var(--c-ink-2); margin-bottom: var(--sp-3); }
  .ch__crumbs a { color: var(--c-sign); }
  .ch__sign { padding: 1.6rem 1.25rem; display: grid; gap: var(--sp-5); }
  .ch__facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .ch__facts li { display: flex; align-items: center; gap: 0.8rem; padding: 0.45rem 0; border-top: 2px solid rgba(255,255,255,.22); font-weight: 600; }
  .ch__ic { width: 40px; height: 40px; flex: none; border-radius: 6px; background: #fff; color: var(--c-sign); display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; font-size: 1.15rem; }
  .ch__sign h1 { font-size: clamp(2.4rem, 5vw + 1rem, 4.8rem); line-height: 0.98; max-width: 14ch; }
  .ch__sign p { margin-top: var(--sp-4); color: var(--c-on-sign-2); font-size: var(--fs-lead); max-width: 40rem; }
  .ch__list { padding-top: var(--sp-6); }
  .ch__count { margin: var(--sp-4) 0 var(--sp-3); font-size: var(--fs-small); color: var(--c-ink-2); }
  .ch__empty { padding: var(--sp-6) 0; display: grid; gap: 0.5rem; justify-items: start; }
  .ch__empty button { background: none; border: 0; padding: 0; cursor: pointer; color: var(--c-sign); }
  @media (min-width: 960px) { .ch__sign { padding: 3rem; grid-template-columns: 1.3fr 1fr; align-items: end; gap: 4rem; } }
</style>
