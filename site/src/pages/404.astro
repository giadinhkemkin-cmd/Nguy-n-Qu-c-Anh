---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Đường cụt" description="Trang này không có trên web Gió Nồm." noindex>
  <section class="nf wrap">
    <svg class="nf__sign" viewBox="0 0 120 120" aria-hidden="true"><rect x="4" y="4" width="112" height="112" rx="12" fill="#1446a0"/><rect x="11" y="11" width="98" height="98" rx="7" fill="none" stroke="#fff" stroke-width="3"/><rect x="50" y="44" width="20" height="54" fill="#fff"/><rect x="34" y="26" width="52" height="18" fill="#c42b1f"/></svg>
    <h1>Đường cụt</h1>
    <p>Trang bạn tìm không có ở đây, có thể link đã đổi. Năm tour vẫn chạy bình thường.</p>
    <div class="nf__go"><a class="btn" href="/tour/">Xem 5 tour <Icon name="arrow-right" /></a><a class="link-arrow" href="/">Về trang chủ</a></div>
  </section>
</Base>
<style>
  .nf { padding-block: var(--sp-8); display: grid; justify-items: start; gap: var(--sp-4); }
  .nf__sign { width: 110px; height: 110px; }
  .nf h1 { font-size: var(--fs-hero); }
  .nf p { font-size: var(--fs-lead); color: var(--c-ink-2); max-width: 32rem; }
  .nf__go { display: flex; gap: 1rem 1.5rem; align-items: center; flex-wrap: wrap; }
</style>
