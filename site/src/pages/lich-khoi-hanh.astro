---
import Base from '../layouts/Base.astro';
import FilterChips from '../components/FilterChips.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { tours, lich, HOM_NAY, ngayVN, maChuyen, congTy, PICTO, MAU_TUYEN } from '../lib/data.js';
const end = new Date(HOM_NAY + 'T00:00:00'); end.setDate(end.getDate() + 27);
const endIso = end.toISOString().slice(0, 10);
const list = lich.chuyen.filter((c) => c.ngay >= HOM_NAY && endIso >= c.ngay);
const byWeek = [];
for (const c of list) {
  const d = new Date(c.ngay + 'T00:00:00');
  const mon = new Date(d); mon.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  const key = mon.toISOString().slice(0, 10);
  let w = byWeek.find((x) => x.key === key);
  if (!w) { w = { key, sun: new Date(mon.getTime() + 6 * 864e5), items: [] }; byWeek.push(w); }
  w.items.push(c);
}
const T = Object.fromEntries(tours.map((t) => [t.slug, t]));
const chips = [{ key: 'all', label: 'Tất cả' }, ...tours.map((t) => ({ key: t.slug, label: t.ten_ngan }))];
const fmt = (d) => `${d.getDate()}/${d.getMonth() + 1}`;
const capNhat = ngayVN(lich.cap_nhat);
const conLai = (c) => (c.con_cho > 0 ? (c.con_cho > 3 ? `Còn ${c.con_cho}/12` : `Sắp hết: còn ${c.con_cho}`) : 'Hết chỗ');
const sap = (c) => c.con_cho > 0 && !(c.con_cho > 3);
---
<Base title="Lịch khởi hành" description="Ngày khởi hành và số chỗ còn lại của 5 tour ghép Gió Nồm trong 4 tuần tới." current="lich">
  <header class="lk">
    <div class="wrap">
      <div class="sign lk__sign">
        <h1>Lịch khởi hành</h1>
        <p>Ngày có đoàn và số chỗ còn lại trong 4 tuần tới, cập nhật {capNhat}. Số chỗ thay đổi trong ngày, nhắn Zalo để giữ chỗ chắc chắn.</p>
      </div>
    </div>
  </header>
  <section class="section lk__body" aria-label="Các chuyến">
    <div class="wrap">
      <FilterChips group="tour" label="Lọc theo tour" items={chips} />
      <p class="lk__note"><Icon name="lan" size={18} />Cù Lao Chàm nghỉ từ tháng 10 đến tháng 2 vì biển động.</p>
      {byWeek.map((w) => (
        <section class="lk__week" aria-label={`Tuần ${fmt(new Date(w.key + 'T00:00:00'))} – ${fmt(w.sun)}`}>
          <h2 class="lk__wh">Tuần {fmt(new Date(w.key + 'T00:00:00'))} – {fmt(w.sun)}</h2>
          <ul class="lk__list">
            {w.items.map((c) => {
              const t = T[c.tour]; const ma = maChuyen(c.tour, c.ngay); const full = !(c.con_cho > 0);
              return (
                <li class:list={['lk__row', { 'is-full': full }]} data-tour={c.tour} style={`--tuyen:${MAU_TUYEN[t.mau]}`}>
                  <span class="lk__date"><strong>{ngayVN(c.ngay, true)}</strong></span>
                  <span class="lk__tour"><span class="lk__pic" aria-hidden="true"><Icon name={PICTO[t.mau]} size={18} /></span><a href={`/tour/${t.slug}/`}>{t.ten_ngan}</a><span class="lk__ma num">{ma}</span></span>
                  <span class:list={['lk__left', { 'is-low': sap(c) }]}>{conLai(c)}</span>
                  {full ? <span class="lk__btn is-off">Hết chỗ</span> : <a class="lk__btn" href={congTy.zalo} target="_blank" rel="noopener" data-zalo data-msg={`Chào Gió Nồm, mình muốn giữ chỗ chuyến ${ma} (${t.ten_ngan}, ${ngayVN(c.ngay)}). Số người: …`} aria-label={`Giữ chỗ ${t.ten_ngan} ${ngayVN(c.ngay)}`}>Giữ chỗ</a>}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <CtaBand title="Không thấy ngày bạn cần?" body="Bà Nà và Hội An chạy hằng ngày, kể cả ngày chưa có khách ghép. Nhắn ngày đi, Gió Nồm mở chuyến." msg="Chào Gió Nồm, mình cần tour … ngày …, … người." />
</Base>
<script>
  import { wireFilter } from '../scripts/filter.js';
  wireFilter('tour', '.lk__row', 'tour', () => {
    document.querySelectorAll<HTMLElement>('.lk__week').forEach((w) => { w.hidden = !w.querySelector('.lk__row:not([hidden])'); });
  });
</script>
<style>
  .lk { padding-top: var(--sp-5); }
  .lk__sign { padding: 1.6rem 1.25rem; }
  .lk__sign h1 { font-size: clamp(2.4rem, 5vw + 1rem, 4.8rem); }
  .lk__sign p { margin-top: var(--sp-3); color: var(--c-on-sign-2); font-size: var(--fs-lead); max-width: 42rem; }
  .lk__body { padding-top: var(--sp-6); }
  .lk__note { display: flex; gap: 0.5rem; align-items: center; font-size: var(--fs-small); color: var(--c-ink-2); margin: var(--sp-3) 0 var(--sp-2); }
  .lk__week { margin-top: var(--sp-6); }
  .lk__wh { font-size: 1.35rem; padding-bottom: 0.5rem; border-bottom: 3px solid var(--c-ink); }
  .lk__list { list-style: none; margin: 0; padding: 0; }
  .lk__row { display: grid; grid-template-columns: 4.6rem 1fr auto; grid-template-areas: 'date tour btn' 'date left btn'; gap: 0.1rem 0.75rem; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--c-rule); }
  .lk__date { grid-area: date; font-family: var(--f-display); font-size: 1.15rem; line-height: 1.1; }
  .lk__tour { grid-area: tour; display: flex; align-items: center; gap: 0.5rem; min-width: 0; flex-wrap: wrap; }
  .lk__tour a { font-weight: 600; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  @media (hover: hover) and (pointer: fine) { .lk__tour a:hover { text-decoration: underline; } }
  .lk__pic { width: 26px; height: 26px; border-radius: 4px; background: var(--c-sign); color: #fff; display: grid; place-items: center; box-shadow: inset 0 -3px 0 var(--tuyen); flex: none; }
  .lk__ma { font-size: var(--fs-tiny); color: var(--c-ink-2); }
  .lk__left { grid-area: left; font-size: var(--fs-small); color: var(--c-ink-2); }
  .lk__left.is-low { color: var(--c-cap); font-weight: 600; }
  .lk__btn { grid-area: btn; display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.95rem; border-radius: var(--r-small); background: var(--c-line); color: var(--c-asphalt); font-family: var(--f-display); font-weight: 700; font-size: 1.05rem; text-decoration: none; transition: background-color var(--dur-ui) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .lk__btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .lk__btn:hover { background: var(--c-line-press); } }
  .lk__btn.is-off { background: #d6d8d2; color: var(--c-ink-2); }
  .is-full .lk__date { color: var(--c-ink-2); text-decoration: line-through; }
  @media (min-width: 760px) {
    .lk__row { grid-template-columns: 7rem 1fr 10rem auto; grid-template-areas: 'date tour left btn'; }
  }
  @media (min-width: 960px) { .lk__sign { padding: 3rem; } }
</style>
