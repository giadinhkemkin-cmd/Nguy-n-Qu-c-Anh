import TourDetail from '../../components/TourDetail.astro';
import TourList from '../../components/TourList.astro';
import worst from '../../../../data/_test/worst-case.json';
const t = worst[0];
---
<Base title="Thử dữ liệu xấu nhất 1" description="Trang thử break-ui" noindex>
  <div class="wrap" style="padding-block:1rem;display:flex;gap:1rem;flex-wrap:wrap">
    <strong>Dữ liệu:</strong><a href="/tour/ba-na-cau-vang/">Demo (dữ liệu thật)</a><a href="/prototype/break-ui-1/">Xấu nhất 1</a><a href="/prototype/break-ui-2/">Xấu nhất 2</a>
  </div>
  <section class="wrap"><TourList list={worst} full /></section>
  <TourDetail t={t} />
</Base>
