---
// Bốn cam kết vẽ thành biển báo: biển giới hạn (12), biển chỉ dẫn (khách sạn), biển hiệu lệnh (giờ), biển phụ (24 giờ).
import Icon from './Icon.astro';
const items = [
  { k: 'limit', title: 'Tối đa 12 khách', body: 'Xe 16 chỗ chỉ chở 12 người, nên không ai ngồi ghế phụ và ai cũng nghe rõ người dẫn.' },
  { k: 'hotel', title: 'Đón tận khách sạn', body: 'Miễn phí trong Hải Châu, Sơn Trà, Ngũ Hành Sơn, Thanh Khê. Người dẫn gọi bạn trước 15 phút.' },
  { k: 'clock', title: 'Đi lệch giờ đông', body: 'Lịch xếp để tới điểm chính trước hoặc sau giờ các đoàn lớn đến.' },
  { k: 'cancel', title: 'Huỷ miễn phí trước 24 giờ', body: 'Báo huỷ trước giờ đón 24 giờ, Gió Nồm hoàn đủ tiền cọc. Tour biển huỷ vì thời tiết cũng hoàn đủ.' },
];
---
<section class="rs section" aria-labelledby="rs-h2">
  <div class="wrap">
    <div class="section-head"><h2 id="rs-h2">Bốn điều Gió Nồm giữ ở mọi chuyến</h2></div>
    <ul class="rs__list">
      {items.map((it) => (
        <li class="rs__item">
          <span class={`rs__sign rs__sign--${it.k}`} aria-hidden="true">
            {it.k === 'limit' && <span class="num">12</span>}
            {it.k === 'hotel' && <Icon name="hotel" size={46} />}
            {it.k === 'clock' && <Icon name="clock" size={50} />}
            {it.k === 'cancel' && <span class="num">24<small>giờ</small></span>}
          </span>
          <div><h3>{it.title}</h3><p>{it.body}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rs__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-5); }
  .rs__item { display: grid; grid-template-columns: 84px 1fr; gap: 1.1rem; align-items: start; }
  .rs__item h3 { font-size: var(--fs-h3); margin-bottom: 0.35rem; }
  .rs__item p { color: var(--c-ink-2); }
  .rs__sign { width: 84px; height: 84px; display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; }
  .rs__item h3 { min-height: 0; }
  @media (min-width: 1200px) { .rs__item { grid-template-rows: 84px auto; } }
  .rs__sign--limit { border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 10px var(--c-cap), 0 6px 14px -8px rgba(0,0,0,.4); font-size: 2.4rem; color: var(--c-ink); }
  .rs__sign--hotel { border-radius: 8px; background: var(--c-sign); color: #fff; box-shadow: inset 0 0 0 4px var(--c-sign), inset 0 0 0 6px #fff, 0 6px 14px -8px rgba(0,0,0,.4); }
  .rs__sign--clock { border-radius: 50%; background: var(--c-sign); color: #fff; box-shadow: 0 6px 14px -8px rgba(0,0,0,.4); }
  .rs__sign--cancel { height: 60px; margin-block: 12px; border-radius: 6px; background: #fff; box-shadow: inset 0 0 0 4px var(--c-ink), 0 6px 14px -8px rgba(0,0,0,.4); font-size: 2rem; line-height: 1; }
  .rs__sign--cancel small { display: block; font-size: 0.85rem; text-align: center; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (min-width: 760px) { .rs__list { grid-template-columns: 1fr 1fr; gap: var(--sp-7) var(--sp-8); } }
  @media (min-width: 1200px) { .rs__list { grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); } .rs__item { grid-template-columns: 1fr; } }
</style>
