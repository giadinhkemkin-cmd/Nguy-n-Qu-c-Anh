---
// Logo đề xuất: hai làn sóng (gió nồm thổi vào bờ) trong tấm biển nhỏ + chữ. [CẦN XÁC NHẬN] khách duyệt
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['logo', cls]}>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><rect width="32" height="32" rx="7" fill="currentColor" opacity=".16"/><rect x="2.5" y="2.5" width="27" height="27" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 19c2.6-3 5.3-3 8 0s5.4 3 8 0" fill="none" stroke="#f3b300" stroke-width="2.6" stroke-linecap="round"/><path d="M8 13.4c2.6-3 5.3-3 8 0s5.4 3 8 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
  <span class="logo__txt">Gió Nồm<span class="logo__sub">Travel</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo__txt { font-family: var(--f-display); font-weight: 700; font-size: 1.35rem; letter-spacing: 0; line-height: 1; display: inline-flex; align-items: baseline; gap: 0.3rem; }
  .logo__sub { font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.8; }
</style>
