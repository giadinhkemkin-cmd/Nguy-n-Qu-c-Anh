---
import SignRows from '../SignRows.astro';
import Icon from '../Icon.astro';
import { congTy } from '../../lib/data.js';
---
<section class="hs" aria-labelledby="hs-h1">
  <div class="hs__wrap wrap">
    <div class="sign hs__panel">
      <div class="hs__copy">
        <h1 id="hs-h1" class="hs__h1">Đà Nẵng lúc còn vắng</h1>
        <p class="hs__lead">Năm tour quanh Đà Nẵng, Hội An và Huế. Mỗi xe chở tối đa 12 khách, giờ đi được xếp để bạn tới Cầu Vàng, Mỹ Sơn, phố Hội trước hoặc sau lúc xe đoàn lớn đến.</p>
        <div class="hs__cta">
          <a class="btn" href={congTy.zalo} target="_blank" rel="noopener" data-zalo data-msg="Chào Gió Nồm, mình muốn hỏi chỗ tour. Ngày đi: …, số người: …"><Icon name="chat" />Nhắn Zalo hỏi chỗ</a>
          <a class="link-arrow hs__more" href="/tour/">Xem 5 tour và giá <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="hs__dest">
        <p class="hs__legend"><span>Điểm chính</span><span>Giờ đoàn tới nơi</span></p>
        <SignRows />
      </div>
    </div>
    <div class="hs__posts" aria-hidden="true"><span></span><span></span></div>
  </div>
  <div class="hs__road" aria-hidden="true"><div class="road-line"></div></div>
</section>
<style>
  .hs { padding-top: var(--sp-4); background: linear-gradient(var(--c-paint) 0 calc(100% - 64px), var(--c-asphalt) 0); }
  .hs__wrap { position: relative; z-index: 1; }
  .hs__panel { padding: 1.6rem 1.25rem 1.1rem; display: grid; gap: var(--sp-6); }
  .hs__h1 { font-size: var(--fs-hero); line-height: 0.95; max-width: 9.5ch; }
  .hs__lead { margin-top: var(--sp-4); font-size: var(--fs-lead); color: var(--c-on-sign-2); max-width: 34rem; line-height: 1.5; }
  .hs__cta { margin-top: var(--sp-5); display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .hs__more { color: #fff; }
  .hs__legend { display: flex; justify-content: space-between; font-size: var(--fs-tiny); text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-on-sign-2); padding: 0 0.25rem 0.35rem; border-bottom: 2px solid rgba(255,255,255,.5); }
  .hs__posts { display: flex; justify-content: space-between; padding-inline: 18%; height: 40px; }
  .hs__posts span { width: 14px; background: linear-gradient(90deg, #9aa0a6, #c9cdd1 45%, #8a9096); }
  .hs__road { background: var(--c-asphalt); height: 64px; display: grid; align-items: center; }
  @media (min-width: 960px) {
    .hs { padding-top: var(--sp-6); }
    .hs__panel { grid-template-columns: 1.05fr 1fr; align-items: end; padding: 3rem 3rem 2.4rem; gap: 3.5rem; }
    .hs__posts { height: 72px; }
  }
</style>
