---
import Milestone from '../Milestone.astro';
import Icon from '../Icon.astro';
import { congTy, tuyen } from '../../lib/data.js';
---
<section class="hmi" aria-labelledby="hmi-h1">
  <div class="hmi__in wrap">
    <div class="hmi__post">
      <Milestone size="lg" top="GIÓ NỒM · QL1A" name="" class="hmi__ms">
        <h1 id="hmi-h1" class="hmi__h1">Đà Nẵng lúc còn vắng</h1>
        <span class="hmi__zero num">0 km</span>
      </Milestone>
    </div>
    <div class="hmi__side">
      <p class="hmi__lead">Năm tour quanh Đà Nẵng, Hội An và Huế. Mỗi xe chở tối đa 12 khách, giờ đi được xếp để bạn tới Cầu Vàng, Mỹ Sơn, phố Hội trước hoặc sau lúc xe đoàn lớn đến.</p>
      <div class="hmi__cta">
        <a class="btn" href={congTy.zalo} target="_blank" rel="noopener" data-zalo data-msg="Chào Gió Nồm, mình muốn hỏi chỗ tour. Ngày đi: …, số người: …"><Icon name="chat" />Nhắn Zalo hỏi chỗ</a>
        <a class="link-arrow" href="/tour/">Xem 5 tour và giá <Icon name="arrow-right" /></a>
      </div>
      <div class="hmi__road">
        <ol class="hmi__posts">
          {tuyen.map((r) => <li><Milestone top={r.ten.split(' ')[0].toUpperCase()} name={r.diem} km={`${r.km} km`} time={r.gio} href={`/tour/${r.slug}/`} color={r.mau} /></li>)}
        </ol>
        <div class="road-line" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
<style>
  .hmi { background: var(--c-sign); color: #fff; padding-block: var(--sp-6) 0; overflow: hidden; }
  .hmi__in { display: grid; gap: var(--sp-6); }
  .hmi__in > * { min-width: 0; }
  .hmi__post { display: grid; justify-items: center; }
  .hmi__h1 { color: var(--c-ink); font-size: clamp(2.6rem, 6vw + 1rem, 4.6rem); line-height: 0.95; text-transform: uppercase; }
  .hmi__zero { font-family: var(--f-display); font-weight: 700; font-size: clamp(2.6rem, 5vw + 1rem, 4rem); color: var(--c-ink); line-height: 1; }
  :global(.hmi__ms .ms__name:empty) { display: none; }
  .hmi__lead { font-size: var(--fs-lead); color: var(--c-on-sign-2); line-height: 1.5; max-width: 32rem; }
  .hmi__cta { margin-top: var(--sp-5); display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; }
  .hmi__road { margin-top: var(--sp-6); margin-inline: calc(-1 * var(--gutter)); background: var(--c-asphalt); padding-top: var(--sp-5); }
  .hmi__posts { list-style: none; margin: 0; padding: 0 var(--gutter) var(--sp-4); display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .hmi__posts li { scroll-snap-align: start; flex: none; }
  .hmi__posts :global(.ms) { --w: 8.6rem; }
  @media (min-width: 960px) {
    .hmi__in { grid-template-columns: auto 1fr; align-items: end; gap: 4rem; }
    .hmi__post :global(.ms--lg) { --w: 24rem; }
    .hmi__road { margin-inline: 0 calc(-1 * var(--gutter)); border-radius: var(--r-sign) 0 0 0; }
  }
</style>
