const isFill = name in FILL;
const body = isFill ? FILL[name] : (STROKE[name] ?? '');
const t = rotate ? `transform:rotate(${rotate}deg)` : undefined;
---
{isFill ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" style={t} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={body} />
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={t} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={body} />
)}
