  'xe': `<path fill-rule="evenodd" d="M3.5 6h13.2c1 0 1.9.5 2.4 1.4l2.3 4.1c.4.7.6 1.4.6 2.2V17a1 1 0 0 1-1 1h-1.2a2.6 2.6 0 0 0-5.1 0H9.1a2.6 2.6 0 0 0-5.1 0H3a1 1 0 0 1-1-1V7.5A1.5 1.5 0 0 1 3.5 6Zm.5 2v3.5h3.6V8zm5.2 0v3.5h3.6V8zm5.2 0v3.5h5.3l-1.7-3a1 1 0 0 0-.9-.5z"/><circle cx="6.55" cy="18.2" r="1.9"/><circle cx="17.45" cy="18.2" r="1.9"/>`,
