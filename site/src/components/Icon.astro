const STROKE = {
  'phone': `<path d="M5 3h3.2l1.6 4.4-2.1 1.4a11.5 11.5 0 0 0 7.5 7.5l1.4-2.1L21 15.8V19a2 2 0 0 1-2.2 2A17.2 17.2 0 0 1 3 5.2 2 2 0 0 1 5 3z"/>`,
