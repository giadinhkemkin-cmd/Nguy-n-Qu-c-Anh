---
import Icon from './Icon.astro';
import { congTy } from '../lib/data.js';
const steps = [
  'Nhắn Zalo tên tour, ngày đi, số người lớn và trẻ em.',
  'Gió Nồm báo còn chỗ và gửi số tài khoản. Bạn cọc 30%.',
  'Tối hôm trước, người dẫn nhắn giờ đón. Phần tiền còn lại trả ngày đi.',
];
const roleIcon = (r) => (r.includes('Điều hành') ? 'phone' : 'xe');
---
<section class="bk section" aria-labelledby="bk-h2">
  <div class="wrap bk__in">
    <div>
      <div class="section-head"><h2 id="bk-h2">Đặt tour qua Zalo, ba bước</h2></div>
      <ol class="bk__steps">
        {steps.map((s, i) => (
          <li><span class="bk__km num" aria-hidden="true"><span>KM</span>{i + 1}</span><p>{s}</p></li>
        ))}
      </ol>
    </div>
    <div class="bk__team">
      <h3>Ba người lo chuyến đi của bạn</h3>
      <p class="bk__team-lead">Từ lúc bạn nhắn Zalo tới lúc xe trả bạn về khách sạn.</p>
      <ul>
        {congTy.doi_ngu.map((p) => (
          <li><span class="bk__av" aria-hidden="true"><Icon name={roleIcon(p.vai_tro)} size={24} /></span><span><strong>{p.ten}</strong><span>{p.vai_tro}</span></span></li>
        ))}
      </ul>
      <p class="bk__note">Ảnh đội ngũ sẽ cập nhật khi có ảnh thật.</p>
    </div>
  </div>
</section>
<style>
  .bk__in { display: grid; gap: var(--sp-7); }
  .bk__steps { list-style: none; margin: 0; padding: 0; display: grid; position: relative; }
  .bk__steps::before { content: ''; position: absolute; left: 31px; top: 20px; bottom: 20px; width: 4px; background: repeating-linear-gradient(180deg, var(--c-asphalt) 0 14px, transparent 14px 24px); }
  .bk__steps li { display: grid; grid-template-columns: 66px 1fr; gap: 1rem; align-items: center; padding-block: 0.6rem; position: relative; }
  .bk__steps p { font-size: var(--fs-lead); }
  .bk__km { width: 66px; height: 74px; background: #fff; border-radius: 33px 33px 3px 3px; box-shadow: inset 0 26px 0 var(--c-cap), 0 6px 12px -8px rgba(0,0,0,.4); display: grid; justify-items: center; align-content: end; padding-bottom: 0.45rem; font-family: var(--f-display); font-weight: 700; font-size: 1.7rem; line-height: 1; position: relative; z-index: 1; }
  .bk__km span { font-size: 0.7rem; color: #fff; letter-spacing: 0.1em; position: absolute; top: 9px; }
  .bk__team { align-self: start; border-top: 3px solid var(--c-ink); padding-top: 1.1rem; }
  .bk__team h3 { font-size: var(--fs-h3); }
  .bk__team-lead { color: var(--c-ink-2); margin-top: 0.3rem; }
  .bk__team ul { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.75rem; }
  .bk__team li { display: flex; gap: 0.85rem; align-items: center; }
  .bk__team li > span:last-child { display: grid; }
  .bk__team li > span:last-child span { font-size: var(--fs-small); color: var(--c-ink-2); }
  .bk__av { width: 48px; height: 48px; border-radius: 8px; background: var(--c-sign); color: #fff; box-shadow: inset 0 0 0 3px var(--c-sign), inset 0 0 0 5px #fff; display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; font-size: 1.4rem; flex: none; }
  .bk__note { margin-top: 1rem; font-size: var(--fs-tiny); color: var(--c-ink-2); }
  @media (min-width: 960px) { .bk__in { grid-template-columns: 1.3fr 1fr; gap: var(--sp-8); align-items: start; } }
</style>
