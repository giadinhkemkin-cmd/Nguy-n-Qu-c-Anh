---
// Trang danh mục: mỗi tour là một "biển tuyến": đầu biển xanh (pictogram + tên), bản đồ tuyến nhỏ,
// giờ tới nơi là số chính, ghế còn trống của chuyến gần nhất, nút vàng giữ chỗ cạnh giá.
import Icon from './Icon.astro';
import RouteMap from './RouteMap.astro';
import { tours, vnd, coGia, diemChinh, PICTO, MAU_TUYEN, dangMua, LOAI, chuyenConCho, ngayVN, maChuyen, khungTuyen, congTy } from '../lib/data.js';
interface Props { list?: typeof tours }
const { list = tours } = Astro.props;
const ghe = (c) => Array.from({ length: 12 }, (_, i) => 12 - c.con_cho > i);
---
<ol class="rc" data-rc>
  {list.map((t) => {
    const d = diemChinh(t); const mua = dangMua(t); const next = mua ? chuyenConCho(t.slug) : null;
    const msg = next ? `Chào Gió Nồm, mình muốn giữ chỗ chuyến ${maChuyen(t.slug, next.ngay)} (${t.ten_ngan}, ${ngayVN(next.ngay)}). Số người lớn: …, trẻ em: …` : `Chào Gió Nồm, báo mình khi tour ${t.ten_ngan} có lịch nhé.`;
    return (
      <li class="rc__item" data-loai={LOAI(t)} style={`--tuyen:${MAU_TUYEN[t.mau]}`}>
        <header class="rc__head">
          <span class="rc__pic" aria-hidden="true"><Icon name={PICTO[t.mau]} size={28} /></span>
          <h2 class="rc__name"><a href={`/tour/${t.slug}/`}>{t.ten_ngan}</a></h2>
          <span class="rc__dur">{t.thoi_luong}</span>
        </header>
        <div class="rc__body">
          <div class="rc__info">
            <p class="rc__desc">{t.mo_ta_ngan}</p>
            <ul class="rc__meta">
              <li><Icon name="clock" size={16} /><span class="num">{t.gio}</span></li>
              <li><Icon name="calendar" size={16} />{mua ? t.lich.mo_ta : 'Nghỉ mùa biển động, mở lại tháng 3'}</li>
              <li><Icon name="users" size={16} />Tối đa {t.nhom_toi_da} khách</li>
            </ul>
            <div class="rc__map"><RouteMap viewBox={khungTuyen(t, 3.2, 30)} only={t.slug} labels={true} places={true} title={`Bản đồ tuyến ${t.ten_ngan}`} /></div>
          </div>
          <div class="rc__deal">
            <p class="rc__arrive"><span>Tới {d.ten}</span><strong class="num tile">{d.gio}</strong></p>
            <p class="rc__price"><span>Người lớn</span><strong class="num">{vnd(t.gia_nguoi_lon)}</strong>{coGia(t.gia_tre_em) && <small>Trẻ em 1–1,4 m: <span class="num">{vnd(t.gia_tre_em)}</span></small>}</p>
            {next ? (
              <div class="rc__seats">
                <span class="rc__seatbar" aria-hidden="true">{ghe(next).map((x) => <i class:list={{ on: x }}></i>)}</span>
                <span>{ngayVN(next.ngay)}: còn <strong class="num">{next.con_cho}/12</strong> chỗ</span>
              </div>
            ) : (
              <p class="rc__off">Tạm nghỉ đến tháng 3</p>
            )}
            <div class="rc__act">
              <a class="btn rc__btn" href={congTy.zalo} target="_blank" rel="noopener" data-zalo data-msg={msg}><Icon name="chat" />{next ? 'Giữ chỗ' : 'Báo khi có lịch'}</a>
              <a class="link-arrow" href={`/tour/${t.slug}/`}>Lịch trình theo giờ <Icon name="arrow-right" /></a>
            </div>
          </div>
        </div>
      </li>
    );
  })}
</ol>
<script>
  // Tuyến trên bản đồ mini vẽ ra khi thẻ vào màn hình (một lần). Reduced-motion: hiện sẵn.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const maps = document.querySelectorAll<HTMLElement>('[data-rc] .rc__map');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.remove('is-wait'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -15% 0px' });
    maps.forEach((m) => { if (m.getBoundingClientRect().top > innerHeight * 0.85) { m.classList.add('is-wait'); io.observe(m); } });
  }
</script>
<style>
  .rc { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-5); }
  .rc__item { background: #fff; border-radius: var(--r-sign); overflow: hidden; box-shadow: 0 1px 0 rgba(13,51,120,.08), 0 18px 36px -28px rgba(13,51,120,.45); }
  .rc__head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.8rem; background: var(--c-sign-tint); color: var(--c-sign-deep); padding: 0.8rem 1rem; box-shadow: inset 0 -4px 0 var(--tuyen); }
  .rc__pic { width: 44px; height: 44px; border-radius: 6px; background: var(--c-sign); color: #fff; display: grid; place-items: center; }
  .rc__name { font-size: clamp(1.5rem, 1.2vw + 1.1rem, 2.1rem); line-height: 1.05; }
  .rc__name a { text-decoration: none; }
  .rc__name a::after { content: ''; }
  @media (hover: hover) and (pointer: fine) { .rc__name a:hover { text-decoration: underline; text-decoration-thickness: 2px; } }
  .rc__dur { font-size: var(--fs-small); color: var(--c-ink-2); white-space: nowrap; }
  .rc__body { display: grid; gap: 1rem; padding: 1rem; }
  .rc__desc { color: var(--c-ink-2); }
  .rc__meta { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: var(--fs-small); color: var(--c-ink-2); }
  .rc__meta li { display: inline-flex; gap: 0.35rem; align-items: center; }
  .rc__meta svg { color: var(--c-sign); }
  .rc__map { margin-top: 0.9rem; border-radius: 6px; overflow: hidden; --map-sea: var(--c-sign); --map-land: #eef0eb; aspect-ratio: 3.2; }
  .rc__map :global(svg) { width: 100%; aspect-ratio: 3.2; height: auto; display: block; }
  .rc__map :global(.rmap__line) { transition: stroke-dashoffset 900ms var(--ease-in-out); }
  .rc__map.is-wait :global(.rmap__line) { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .rc__deal { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem 1.2rem; align-content: start; }
  .rc__arrive, .rc__price { display: grid; gap: 0.2rem; align-content: start; }
  .rc__arrive span, .rc__price > span { font-size: var(--fs-tiny); color: var(--c-ink-2); }
  .rc__arrive strong { font-family: var(--f-display); font-size: 1.9rem; justify-self: start; }
  .rc__price strong { font-family: var(--f-display); font-size: 1.9rem; line-height: 1; padding-top: 0.22em; }
  .rc__price small { font-size: var(--fs-tiny); color: var(--c-ink-2); }
  .rc__seats, .rc__off, .rc__act { grid-column: 1 / -1; }
  .rc__seats { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; font-size: var(--fs-small); }
  .rc__seatbar { display: grid; grid-template-columns: repeat(12, 10px); gap: 3px; }
  .rc__seatbar i { width: 10px; height: 10px; border-radius: 2px; box-shadow: inset 0 0 0 2px var(--c-sign); }
  .rc__seatbar i.on { background: var(--c-sign); }
  .rc__off { color: var(--c-cap); font-weight: 600; }
  .rc__act { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.2rem; }
  .rc__btn { min-height: 48px; }
  .rc__act .link-arrow { color: var(--c-sign); }
  @media (min-width: 760px) {
    .rc__body { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem; padding: 1.4rem 1.6rem 1.6rem; }
    .rc__head { padding: 0.9rem 1.6rem; }
  }
</style>
