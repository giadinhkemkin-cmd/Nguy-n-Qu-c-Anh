---
// Hàng lọc dạng biển phụ (tấm trắng viền đen). data-filter-group nối với danh sách có data-loai / data-tour.
interface Props { group: string; items: { key: string; label: string; count?: number }[]; label: string }
const { group, items, label } = Astro.props;
---
<div class="fc" role="group" aria-label={label} data-filter-group={group}>
  {items.map((it, i) => (
    <button type="button" class="fc__chip" data-key={it.key} aria-pressed={i === 0 ? 'true' : 'false'}>
      {it.label}{typeof it.count === 'number' && <span class="num">{it.count}</span>}
    </button>
  ))}
</div>
<style>
  .fc { display: flex; gap: 0.5rem; overflow-x: auto; padding: 0.25rem var(--gutter) 0.5rem; margin-inline: calc(-1 * var(--gutter)); scrollbar-width: none; overscroll-behavior-x: contain; }
  .fc::-webkit-scrollbar { display: none; }
  .fc__chip { flex: none; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1rem; border: 0; border-radius: 5px; background: #fff; box-shadow: inset 0 0 0 2px var(--c-ink); font-family: var(--f-display); font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: background-color var(--dur-ui) var(--ease-out), color var(--dur-ui) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .fc__chip .num { font-size: 0.9rem; opacity: 0.7; }
  .fc__chip[aria-pressed='true'] { background: var(--c-sign); color: #fff; box-shadow: inset 0 0 0 2px var(--c-sign), inset 0 0 0 4px #fff; }
  .fc__chip:active { transform: scale(0.97); }
  @media (min-width: 760px) { .fc { margin-inline: 0; padding-inline: 0; flex-wrap: wrap; } }
</style>
