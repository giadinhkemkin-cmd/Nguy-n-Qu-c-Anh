---
// Dải hành động dính đáy trên mobile: hiện sau khi qua màn đầu, ẩn khi tới chân trang.
import Icon from './Icon.astro';
import { congTy } from '../lib/data.js';
interface Props { msg?: string; always?: boolean }
const { msg = 'Chào Gió Nồm, mình muốn hỏi chỗ tour. Tour: …, ngày đi: …, số người: …', always = false } = Astro.props;
---
<div class="ab" data-actionbar data-always={always ? '' : undefined}>
  <a class="btn ab__zalo" href={congTy.zalo} target="_blank" rel="noopener" data-zalo data-msg={msg}><Icon name="chat" />Nhắn Zalo hỏi chỗ</a>
  <a class="btn btn--dark ab__call" href={`tel:${congTy.dien_thoai_tel}`} aria-label={`Gọi ${congTy.dien_thoai}`}><Icon name="phone" /></a>
</div>
<script>
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  const hero = document.querySelector('main > section, main > header');
  const foot = document.querySelector('footer');
  if (bar) {
    let pastHero = false, atFoot = false;
    const upd = () => bar.classList.toggle('is-on', pastHero && !atFoot);
    if (bar.hasAttribute('data-always')) { pastHero = true; upd(); }
    else if (hero) new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; upd(); }).observe(hero);
    else { pastHero = true; upd(); }
    if (foot) new IntersectionObserver(([e]) => { atFoot = e.isIntersecting; upd(); }, { rootMargin: '0px 0px -40% 0px' }).observe(foot);
  }
</script>
<style>
  .ab { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 0.5rem; padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom)); background: var(--c-paint); box-shadow: 0 -1px 0 var(--c-rule), 0 -10px 24px -16px rgba(0,0,0,.35); transform: translateY(110%); transition: transform 260ms var(--ease-drawer); }
  .ab.is-on { transform: translateY(0); }
  .ab__zalo { flex: 1; }
  .ab__call { width: 56px; padding: 0; }
  @media (min-width: 960px) { .ab { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ab { transition: opacity 200ms; transform: none; opacity: 0; pointer-events: none; } .ab.is-on { opacity: 1; pointer-events: auto; } }
</style>
