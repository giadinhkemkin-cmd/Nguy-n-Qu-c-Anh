---
// Các dòng trên biển chỉ dẫn: mũi tên theo hướng thật từ văn phòng, pictogram, tên, km, giờ tới nơi.
import Icon from './Icon.astro';
import { tuyen } from '../lib/data.js';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<ol class:list={['rows', { 'rows--compact': compact }]}>
  {tuyen.map((r) => (
    <li>
      <a class="row" href={`/tour/${r.slug}/`} style={`--tuyen:${r.mau}`}>
        <span class="row__dir" aria-hidden="true"><Icon name="mui-ten" size={30} rotate={r.huong} /></span>
        <span class="row__pic" aria-hidden="true"><Icon name={r.picto} size={30} /></span>
        <span class="row__name">
          <span class="row__ten">{r.diem}</span>
          <span class="row__sub">{r.ten} · <span class="num">{r.km} km</span></span>
        </span>
        <span class="row__time" aria-label={`tới nơi lúc ${r.gio}`}><span class="row__cap" aria-hidden="true"></span><span class="num">{r.gio}</span></span>
      </a>
    </li>
  ))}
</ol>
<style>
  .rows { list-style: none; margin: 0; padding: 0; display: grid; }
  .rows li + li { border-top: 2px solid rgba(255,255,255,.22); }
  .row { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.7rem 0.25rem; text-decoration: none; color: var(--c-on-sign); min-height: 64px; position: relative; }
  .row__dir { width: 34px; height: 34px; display: grid; place-items: center; }
  .row__dir svg { transition: transform 420ms var(--ease-out); }
  .row__pic { width: 40px; height: 40px; border-radius: 6px; background: var(--c-on-sign); color: var(--c-sign); display: grid; place-items: center; box-shadow: inset 0 -4px 0 var(--tuyen); }
  .row__pic svg { width: 26px; height: 26px; }
  .row__name { display: grid; min-width: 0; }
  .row__ten { font-family: var(--f-display); font-weight: 700; font-size: clamp(1.3rem, 2vw + 0.9rem, 2.1rem); line-height: 1.05; text-transform: var(--case-sign); letter-spacing: 0.01em; }
  .row__sub { font-size: var(--fs-small); color: var(--c-on-sign-2); line-height: 1.35; }
  .row__time { position: relative; background: #fff; color: var(--c-cap); border-radius: 5px; padding: 0.55rem 0.55rem 0.3rem; overflow: hidden; min-width: 4.4rem; text-align: center; }
  .row__cap { position: absolute; inset: 0 0 auto; height: 6px; background: var(--c-cap); }
  .row__time .num { font-weight: 700; font-size: clamp(1.35rem, 1.4vw + 1rem, 1.9rem); line-height: 1; letter-spacing: 0.01em; }
  @media (hover: hover) {
    .row::before { content: ''; position: absolute; inset: 2px -0.5rem; border-radius: 6px; background: rgba(255,255,255,.08); opacity: 0; transition: opacity var(--dur-ui) var(--ease-out); }
    .row:hover::before { opacity: 1; }
    .row:hover .row__ten { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  }
  .row:active { transform: scale(0.99); }
  .rows--compact .row__ten { font-size: 1.3rem; }
  @media (max-width: 380px) { .row { gap: 0.5rem; } .row__dir { display: none; } }
</style>
