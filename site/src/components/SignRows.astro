---
// Các dòng trên biển chỉ dẫn: mũi tên theo hướng thật từ văn phòng, pictogram, tên điểm, km, giờ tới nơi.
// data-huong: góc thật; script hero xoay mũi tên từ 0° về góc này khi vào trang.
import Icon from './Icon.astro';
import { tuyen } from '../lib/data.js';
---
<ol class="rows">
  {tuyen.map((r) => (
    <li>
      <a class="row" href={`/tour/${r.slug}/`} style={`--tuyen:${r.mau};view-transition-name:sign-${r.slug}`}>
        <span class="row__dir" aria-hidden="true" data-huong={r.huong}><Icon name="mui-ten" size={28} rotate={r.huong} /></span>
        <span class="row__pic" aria-hidden="true"><Icon name={r.picto} size={26} /></span>
        <span class="row__name">
          <span class="row__ten">{r.diem}</span>
          <span class="row__sub"><span class="row__tour">{r.ten} · </span><span class="num">{r.km} km</span></span>
        </span>
        <span class="row__time"><span class="sr-only">tới nơi lúc </span><span class="num flap" data-flap={r.gio}>{r.gio}</span></span>
      </a>
    </li>
  ))}
</ol>
<style>
  .rows { list-style: none; margin: 0; padding: 0; display: grid; }
  .rows li + li { border-top: 2px solid rgba(255,255,255,.22); }
  .row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.75rem; padding: 0.6rem 0.15rem; text-decoration: none; color: var(--c-on-sign); min-height: 60px; position: relative; }
  .row__dir { display: none; width: 32px; height: 32px; place-items: center; }
  .row__pic { width: 36px; height: 36px; border-radius: 6px; background: var(--c-on-sign); color: var(--c-sign); display: grid; place-items: center; box-shadow: inset 0 -4px 0 var(--tuyen); }
  .row__pic svg { width: 24px; height: 24px; }
  .row__name { display: grid; min-width: 0; }
  .row__ten { font-family: var(--f-display); font-weight: 700; font-size: 1.3rem; line-height: 1.12; text-transform: var(--case-sign); letter-spacing: 0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row__sub { font-size: var(--fs-tiny); color: var(--c-on-sign-2); line-height: 1.3; }
  .row__tour { display: none; }
  .row__time { position: relative; background: #fff; color: var(--c-time); border-radius: 4px; padding: 0.45rem 0.5rem 0.25rem; min-width: 4.2rem; text-align: center; box-shadow: inset 0 4px 0 var(--c-cap); }
  .row__time .num { display: inline-block; font-weight: 700; font-size: 1.45rem; line-height: 1; letter-spacing: 0.02em; }
  @media (min-width: 600px) {
    .row { grid-template-columns: auto auto 1fr auto; gap: 0.85rem; padding: 0.75rem 0.25rem; min-height: 68px; }
    .row__dir { display: grid; }
    .row__pic { width: 40px; height: 40px; }
    .row__pic svg { width: 26px; height: 26px; }
    .row__ten { font-size: clamp(1.4rem, 1.2vw + 1rem, 2rem); white-space: normal; }
    .row__sub { font-size: var(--fs-small); }
    .row__tour { display: inline; }
    .row__time .num { font-size: clamp(1.4rem, 1vw + 1rem, 1.85rem); }
  }
  @media (hover: hover) and (pointer: fine) {
    .row::before { content: ''; position: absolute; inset: 2px -0.6rem; border-radius: 6px; background: rgba(255,255,255,.08); opacity: 0; transition: opacity var(--dur-ui) var(--ease-out); }
    .row:hover::before { opacity: 1; }
    .row:hover .row__ten { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  }
  .row:active { transform: scale(0.99); transition: transform var(--dur-press) var(--ease-out); }
</style>
