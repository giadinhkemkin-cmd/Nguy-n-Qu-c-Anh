---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { congTy, tours } from '../lib/data.js';
---
<footer class="ftr">
  <div class="road-line" aria-hidden="true"></div>
  <div class="ftr__in wrap">
    <div class="ftr__brand">
      <Logo />
      <p>Tour ghép nhóm nhỏ quanh Đà Nẵng, Hội An, Huế. Mỗi xe tối đa 12 khách.</p>
    </div>
    <nav class="ftr__col" aria-label="Tour">
      <h2>Tour</h2>
      <ul>{tours.map((t) => <li><a href={`/tour/${t.slug}/`}>{t.ten_ngan}</a></li>)}</ul>
    </nav>
    <div class="ftr__col">
      <h2>Liên hệ</h2>
      <ul>
        <li><a href={`tel:${congTy.dien_thoai_tel}`}><Icon name="phone" size={18} />{congTy.dien_thoai}</a></li>
        <li><a href={`mailto:${congTy.email}`}><Icon name="mail" size={18} />{congTy.email}</a></li>
        <li><span><Icon name="pin" size={18} />{congTy.dia_chi}</span></li>
        <li><span><Icon name="clock" size={18} />{congTy.gio_lam_viec}</span></li>
      </ul>
    </div>
  </div>
  <div class="ftr__legal wrap">
    <p>{congTy.ten_phap_ly}. Giấy phép lữ hành nội địa: đang cập nhật. <a href="/lien-he/#chinh-sach">Chính sách đặt cọc và huỷ tour</a></p>
    <p class="ftr__test">Trang web thử nghiệm: tên công ty, số điện thoại, địa chỉ, giá và lịch là dữ liệu giả.</p>
  </div>
</footer>
<style>
  .ftr { background: var(--c-asphalt); color: #e9eaec; margin-top: var(--sp-8); padding-bottom: calc(5rem + env(safe-area-inset-bottom)); }
  .ftr__in { display: grid; gap: var(--sp-6); padding-block: var(--sp-7) var(--sp-6); }
  .ftr__brand p { margin-top: var(--sp-3); color: #b9bcc2; max-width: 28rem; }
  .ftr h2 { font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-line); margin-bottom: var(--sp-3); }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .ftr li a, .ftr li span { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 40px; text-decoration: none; color: #e9eaec; }
  .ftr li svg { flex: none; color: #9aa0a8; }
  @media (hover: hover) { .ftr li a:hover { color: #fff; text-decoration: underline; } }
  .ftr__legal { border-top: 1px solid var(--c-asphalt-2); padding-top: var(--sp-5); font-size: var(--fs-tiny); color: #a5a9b0; display: grid; gap: 0.35rem; }
  .ftr__test { color: var(--c-line); }
  .ftr__legal a { color: #e9eaec; }
  @media (min-width: 760px) { .ftr__in { grid-template-columns: 1.4fr 1fr 1.3fr; } .ftr { padding-bottom: var(--sp-5); } }
</style>
